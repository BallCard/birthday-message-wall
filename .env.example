# Passphrase protection (optional)
PASSPHRASE_ENABLED=false
# Required when PASSPHRASE_ENABLED=true. Use a private, non-default value.
PASSPHRASE_SECRET=

# Birthday person's name (displayed in header)
BIRTHDAY_PERSON=寿星名字

# CORS origins (comma-separated, empty = allow all)
CORS_ORIGINS=http://localhost:5173

# Vercel KV (auto-configured in Vercel dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=
